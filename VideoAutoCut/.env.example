# 千问 / DashScope API Key
DASHSCOPE_API_KEY=

# Optional relay root. Leave empty to call DashScope directly. When set, every
# DashScope API (Chat, Files, TTS, ASR, voice, uploads and embedding) uses it.
# Example: https://api.evstai.com
DASHSCOPE_BASE_URL=

# SentrySearch 使用的多模态 embedding 模型
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding

# VideoAuto 生成分镜用的文本模型
DASHSCOPE_TEXT_MODEL=qwen-plus

# 脚本解析后拿脚本原文核对上屏字段（card_content / card_hint）和分镜标题（title），**默认开启**。
# AI 解析脚本文档时会丢字、把中文卡片样式翻成英文、在作者写「（不填）」的地方凭空造一条、
# 把分镜标题改写掉（2026-09-21 在 5 份测试脚本上实测 10 处上屏字段 + 2 处标题）。
# 「只按脚本上屏」口径下上屏字段直接决定这一镜上不上卡片，标题会上进度条，所以解析完成后
# 从脚本原文里重抽一遍，不一致就**以脚本原文为准**自动纠正并打告警。
#
# 认哪些格式（都只用标准库读，不装任何第三方包）：
#   md / txt / json / srt  -> 按「分镜 N」切块 + 「键：值」行
#   xlsx / xlsm            -> 认表头列名，每个数据行 = 一镜（表头不必在第 1 行）
#   csv                    -> 先按表格认表头，认不出再退回纯文本那条路
#   docx                   -> 取出纯文本后走纯文本那条路
#   pdf / doc / xls        -> 读不了，零动作
# 只有能认出结构、块数与分镜数一致、且这一镜能被口播/字幕/标题认出来时才会动手；
# 其余情况一律只提示不改，任何情况都不中断任务。
#
# title 有一条额外规则：脚本原文**没写**标题时，plan 里那个自拟或 schema 兜底的
# 「分镜N」不算臆造，不会被清空；只有「原文写了而 plan 不同」才纠正。
# module_label（进度条章节名）是解析器生成的，不纳入校验。
# 设 0 表示只提示不纠正。
# VIDEOAUTO_SCRIPT_CARD_AUTOFIX=1

# 一般不用改。海外/国际站接口才可能需要改。
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# VideoAuto 默认运行配置。命令行参数优先级高于这里。
# SOURCE 可填: bilibili / youtube / google-video / yahoo-video / niconico / netverse / rokfin
SOURCE=bilibili
DOWNLOADS_PER_SHOT=2
CLIPS_PER_SHOT=1
RESULTS_PER_SHOT=10
CHUNK_DURATION=30
VOICEOVER=true
SUBTITLES=true
PROGRESS_BAR=true
# 可选：检测并拒用带字幕、logo、水印或无法确认的候选素材。
MATERIAL_EXCLUDE_OVERLAYS=false
# 可选：指定范围无匹配时，从同一范围的有效视频中随机补位。
MATERIAL_RANDOM_BOUND_FALLBACK=false
# 可选（试验）：指定范围内的选片交给 agent 判断，关闭时与原版逐字相同。
# 需要同时开启 MATERIAL_EXCLUDE_OVERLAYS，并把素材匹配最低分设为 0；
# 开启 MATERIAL_RANDOM_BOUND_FALLBACK 只为把索引目录传给脚本，agent 从不随机选片。
MATERIAL_AGENT_SELECT=false
# 以下为 agent 的可选参数，均有默认值，不填即可。
# 后端。默认 dashscope（直接调 DashScope）。运行包自带 pi，但**只有显式填 pi 才会走 pi**，
# 不会因为机器上/包里有 pi 就自动切过去（2026-09-17 收紧，旧版是「找得到 pi 就默认 pi」）。
# MATERIAL_AGENT_BACKEND=pi
# DashScope 思考模式：on / off；留空保留服务端默认。Qwen3.6 的稳定 JSON 输出需 off。
# MATERIAL_AGENT_DASHSCOPE_THINKING=off
# pi 的 provider 与看图模型。provider=dashscope 时复用账号下发的 DASHSCOPE_API_KEY，无需另配。
# MATERIAL_AGENT_PI_PROVIDER=dashscope
# MATERIAL_AGENT_PI_MODEL=qwen3-vl-plus
# 文字改写检索词用的模型，可与看图模型不同；留空时同看图模型。
# MATERIAL_AGENT_PI_TEXT_MODEL=qwen-plus
# 换 DeepSeek / Anthropic 等 provider 时的 key；该机 pi 已 /login 过则不必填。
# MATERIAL_AGENT_PI_API_KEY=
# provider 为 dashscope / evst-gateway 时自动复用账号下发的 DASHSCOPE_API_KEY；其他 provider 想复用同一把 key 填 dashscope。
# MATERIAL_AGENT_PI_API_KEY_FROM=
# pi 思考档位：off / minimal / low / medium / high / xhigh / max。看图判断不需要长推理。
# MATERIAL_AGENT_PI_THINKING=off
# pi 可执行文件路径。**留空即可**：脚本先找运行包自带的
# tools/material_gen/pi/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js，
# 找不到才走 PATH 上的 pi。想换别处的 pi 才填这里，可直接指向 cli.js（脚本自动加 node）。
# cli.js **不是**自包含 bundle：同目录的 node_modules 必须在（缺 @earendil-works/chord
# 会报 ERR_MODULE_NOT_FOUND，且它装在 pi 包自己的 node_modules 里不提升）。运行包自带的
# 那份约 1.35 万文件 / 117.8MB（字节总和；du 磁盘占用约 137MB），由打包前
# `python tools/material_gen/pi/install_pi.py` 装出来（详见该目录 README.md）。
# Windows 上别指向 pi.cmd / pi.bat：cmd 转发参数时会在第一个换行处截断，多行 system prompt
# 和其后的图片、用户文本全丢（脚本检测到 .cmd 会自己找同目录的 cli.js，找不到直接报错）。
# MATERIAL_AGENT_PI_EXE=
# 运行 cli.js 用的 node。**留空即可**：顺序是 VIDEOAUTO_NODE_EXE → 运行包 node-runtime/node.exe
# → node/node.exe → pi 同目录的 node → PATH，运行包自带 node-runtime 时自动命中。
# MATERIAL_AGENT_NODE_EXE=
# 只给打包机用：install_pi.py 装 pi 时找不到 npm（或想换一个）时指向 npm 可执行文件，
# Windows 上是 npm.cmd。终端用户跑不到这个脚本，留空即可。
# MATERIAL_AGENT_NPM_EXE=
# 填 1 时跳过「首启把包内 models.{provider}.json 合并进 %USERPROFILE%\.pi\agent\models.json」。
# 自己维护 pi models.json 的机器用；关掉后 provider 没配好 pi 会直接报错。
# MATERIAL_AGENT_PI_SKIP_PROVIDER_MERGE=1
# 调试开关：填 1 时每次调 pi 前打一行 `[agent] pi command: …`，方便核对实际发出的参数。
# --api-key 的值打成 ***，--system-prompt 和用户文本只打前 60 字 + 总长度，不会泄漏 key 和全文。
# MATERIAL_AGENT_PI_DEBUG_COMMAND=1
# 最多改写几条检索词重搜，0 表示只判断引擎给的候选。引擎超时就调小。
# MATERIAL_AGENT_MAX_QUERIES=3
# 每条检索词导出几段候选。
# MATERIAL_AGENT_SAVE_PER_QUERY=3
# 送模型判断的候选上限。评审是单次调用带上全部拼图，耗时几乎只跟候选数走
# （2026-09-17 实测 8 个候选约 28 秒/镜）：嫌慢就调到 6，评审时间大致按比例降。
# 注意名额是按比例分的，调小后 agent 重搜的名额跟着缩（6 × 0.4 → ceil = 3 个，
# 引擎候选 3 个），重搜结果入池会变少，要和 MATERIAL_AGENT_RESERVE_RATIO 一起看。
# MATERIAL_AGENT_MAX_CANDIDATES=8
# 评审池里给 agent 重搜结果保留的名额比例（0–1，默认 0.4）。
# 上限 8 时 agent 至少占 ceil(8*0.4)=4 个，其余按向量分给引擎候选；
# 哪一方候选不够，名额自动让给另一方。设 0 表示只在引擎候选不足时才补 agent 结果。
# MATERIAL_AGENT_RESERVE_RATIO=0.4
# 候选可用的最低分（0–100，默认 60）。模型分先按确定性兜底调整（方向存疑 -30、
# 主体部分遮挡上限 75、大面积遮挡上限 50 且直接否决），调整后低于此分的候选一律
# acceptable=false（另有 missing 条数封顶：1 条 89、2 条 75、≥3 条 55）。全部候选都被拒
# 时按 MATERIAL_AGENT_FALLBACK 处理（默认占位出片，见下），任何情况下都不随机兜底。
# 设 0 表示回到只看模型自己的 acceptable。
# MATERIAL_AGENT_MIN_ACCEPT_SCORE=60
# 模型没有推荐任何候选（pick 为空）或候选全被否决时怎么办：
# fill（默认）= 从被拒候选里挑一条占位继续出片，报告 fallback_used=true、
#   material-agent-log.json 记 fallback_used，picked 的 reason 以「【占位】」开头，
#   引擎日志一眼能看出这一镜是兜底的；占位顺序为 方向 upright 优先 → 遮挡
#   none < partial < heavy → 调整后分数高 → agent 重搜命中多 → 先发现的。
#   占位成片必须人工复核，errors 里留着每个候选缺什么。
# stop = 任务在该镜停下（ok=false、paths 为空），只写 fallback_suggestion 供人工判断。
# MATERIAL_AGENT_FALLBACK=fill
# 画面方向单独判一次（不给分镜文案，只问哪几张图整幅转了 90°/180°），结果与评审的
# orientation 合并：任一边说 rotated 就按 rotated 拒（宁可错拒）。同一段素材在本次任务里
# 被判过 rotated 会记进 clips/_agent_cache/orientation.json，后面的分镜直接沿用该结论
# （方向调用照常发起，只是结果被覆盖）。留空时用同一个看图模型，一般不必填。
# 对 pi 后端同样生效：这一步临时覆盖 MATERIAL_AGENT_PI_MODEL（dashscope 侧覆盖
# DASHSCOPE_VISUAL_REVIEW_MODEL），调用结束即还原，评审那一步仍用原模型。
# MATERIAL_AGENT_ORIENTATION_MODEL=qwen3-vl-plus
# 每个候选抽几帧拼成一张图。
# MATERIAL_AGENT_FRAMES=3
# 单次模型调用超时（秒）。
# MATERIAL_AGENT_TIMEOUT=240
# 可选：无足够下黑边时检测主体，寻找字幕可放置的位置。
SUBTITLE_AI_SAFE_AREA=false
DASHSCOPE_VISUAL_REVIEW_MODEL=qwen3-vl-plus
# 固定 HyperFrames 标题、参数、CTA 叠加；默认关闭，不调用模型。
VIDEOAUTO_TEMPLATE_PACKAGING=false
# 只按脚本上屏，**默认开启**（没有这个键也按开启算）。只在模板包装开启时有意义：
# 开：只有脚本写了「上屏文字」（card_content）的分镜才会出现卡片，没写的分镜不上卡片，
#     也不会去调包装 agent（省一次模型调用）。上屏内容一律以脚本为准，模型不产出上屏文字。
# 关（0/false/no/off）：恢复旧行为——没写上屏文字的分镜拿分镜标题（title）当卡片文字。
VIDEOAUTO_PACKAGING_SCRIPT_ONLY=true
# 模板包装的版式选择交给 agent（试验，默认关闭）。只在 VIDEOAUTO_TEMPLATE_PACKAGING=true
# 时才有意义：agent 只从 title / parameters / cta 三个固定版式里挑一个并判断这一镜要不要
# 上包装，**不产出也不改写任何上屏文字**；失败、超时、返回不合法一律退回正则选择照常出片。
# PACKAGING_AGENT_SELECT=1
# 后端。没显式配成 pi 一律走 dashscope 直调（与 MATERIAL_AGENT_BACKEND 同款收紧逻辑）。
# pi 的 provider / 模型 / 密钥 / 可执行文件沿用 MATERIAL_AGENT_PI_* 那一套，不用配第二遍。
# PACKAGING_AGENT_BACKEND=pi
# ⚠️ **配了 BACKEND=pi 就必须一起配下面 4 个键**，否则 provider 取默认值 dashscope，
# 而运行包里只带 models.evst-gateway.json → pi 报 Unknown provider → 每镜 0.2s 静默降级，
# 成片照出但模型全程没参与（2026-09-21 Windows 实测，5 条脚本整跑 agent 全降级）。
# 现在这种情况会在第一次调用前打一行 `[agent] ⚠ pi provider …` 告警，但不阻断。
# MATERIAL_AGENT_PI_PROVIDER=evst-gateway
# MATERIAL_AGENT_PI_MODEL=qwen3.6-plus
# MATERIAL_AGENT_PI_TEXT_MODEL=qwen-plus
# MATERIAL_AGENT_PI_THINKING=off
# 单次模型调用超时（秒），取值收在 30–600。
# PACKAGING_AGENT_TIMEOUT=90
# 只覆盖这一步的模型（两个后端各自读的模型键都会被临时盖上），留空用后端默认。
# PACKAGING_AGENT_MODEL=qwen3.6-plus
# 决策缓存：同一份文案重渲不换版式。设 0 关掉，每镜都重新问模型。
# PACKAGING_AGENT_CACHE=1

# 背景音乐。素材获取以及单次搜索、下载均有超时边界，避免素材站异常时长时间卡住。
BGM_ENABLED=true
BGM_SOURCE=auto
BGM_VOLUME=0.16
BGM_MIN_DURATION=15
BGM_MAX_DURATION=300
BGM_ACQUIRE_TIMEOUT_SECONDS=180
BGM_SEARCH_TIMEOUT_SECONDS=75
BGM_HTTP_TIMEOUT_SECONDS=20
BGM_HTTP_ATTEMPTS=2
BGM_DOWNLOAD_TIMEOUT_SECONDS=120
BGM_DOWNLOAD_ITEM_TIMEOUT_SECONDS=45

# 口播 TTS 配置
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang
DASHSCOPE_TTS_FORMAT=mp3

DASHSCOPE_TTS_SAMPLE_RATE=24000

# Electron 桌面端软件更新（可选）
# VIDEOAUTO_UPDATE_URL=https://download.example.com/videoautocut/
# VIDEOAUTO_AUTO_UPDATE=true
# 开发环境本地测试更新时才开启：
# VIDEOAUTO_UPDATE_FORCE_DEV=false
